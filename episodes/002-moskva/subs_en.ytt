<?xml version="1.0" encoding="utf-8"?><timedtext format="3"><head><pen id="1" b="1" fc="#F6ECD6" fo="254" bo="0" et="3" ec="#120A06" sz="85" fs="4"/><pen id="2" b="1" fc="#E8A33C" fo="254" bo="0" et="3" ec="#120A06" sz="85" fs="4"/><wp id="1" ap="7" ah="50" av="74"/><ws id="1" ju="2"/></head><body><p t="50" d="871" wp="1" ws="1" p="1">There's a sea</p><p t="921" d="1072" wp="1" ws="1" p="2">over Red Square!</p><p t="1993" d="1608" wp="1" ws="1" p="2">Right above the Kremlin!</p><p t="3710" d="1135" wp="1" ws="1" p="1">Don't believe me?</p><p t="4845" d="1201" wp="1" ws="1" p="2">Let's rewind time!</p><p t="6738" d="975" wp="1" ws="1" p="1">Three hundred ten</p><p t="7713" d="1033" wp="1" ws="1" p="1">million years ago,</p><p t="8746" d="573" wp="1" ws="1" p="1">a warm sea</p><p t="9320" d="1147" wp="1" ws="1" p="1">splashed right here.</p><p t="10552" d="1170" wp="1" ws="1" p="1">Its shells became</p><p t="11722" d="825" wp="1" ws="1" p="1">white stone.</p><p t="12548" d="1376" wp="1" ws="1" p="1">They even named this</p><p t="13924" d="1238" wp="1" ws="1" p="2">age the Moscovian!</p><p t="15278" d="1530" wp="1" ws="1" p="1">Then a glacier came</p><p t="16808" d="1932" wp="1" ws="1" p="1">and dragged in boulders.</p><p t="18740" d="1127" wp="1" ws="1" p="1">One still sits</p><p t="19868" d="1288" wp="1" ws="1" p="2">in Kolomenskoye!</p><p t="21269" d="2256" wp="1" ws="1" p="1">Moscow's very first mention?</p><p t="23525" d="1612" wp="1" ws="1" p="1">A dinner invitation.</p><p t="25137" d="1450" wp="1" ws="1" p="2">One mighty dinner!</p><p t="26700" d="1359" wp="1" ws="1" p="1">Prince Dmitry Donskoy</p><p t="28059" d="1165" wp="1" ws="1" p="1">builds the Kremlin</p><p t="29225" d="1100" wp="1" ws="1" p="1">from white stone.</p><p t="30326" d="1295" wp="1" ws="1" p="2">That same sea stone!</p><p t="31718" d="1046" wp="1" ws="1" p="1">The red Kremlin</p><p t="32764" d="1534" wp="1" ws="1" p="1">was built by Italians.</p><p t="34299" d="906" wp="1" ws="1" p="1">Then the tsar</p><p t="35206" d="488" wp="1" ws="1" p="1">had it…</p><p t="35694" d="837" wp="1" ws="1" p="2">whitewashed!</p><p t="36653" d="635" wp="1" ws="1" p="1">They cast</p><p t="37288" d="917" wp="1" ws="1" p="1">the Tsar Bell</p><p t="38206" d="1200" wp="1" ws="1" p="2">two hundred tons!</p><p t="39406" d="847" wp="1" ws="1" p="1">And it never</p><p t="40253" d="705" wp="1" ws="1" p="1">rang once.</p><p t="41039" d="1049" wp="1" ws="1" p="1">Napoleon waited</p><p t="42088" d="839" wp="1" ws="1" p="1">for the keys</p><p t="42928" d="699" wp="1" ws="1" p="1">to Moscow.</p><p t="43628" d="279" wp="1" ws="1" p="1">Nope</p><p t="43908" d="559" wp="1" ws="1" p="1">the city</p><p t="44468" d="629" wp="1" ws="1" p="1">was empty</p><p t="45098" d="839" wp="1" ws="1" p="1">and burning.</p><p t="46022" d="2654" wp="1" ws="1" p="1">Mayakovskaya metro station won</p><p t="48676" d="1061" wp="1" ws="1" p="1">a Grand Prix</p><p t="49738" d="1061" wp="1" ws="1" p="2">in New York!</p><p t="50915" d="1573" wp="1" ws="1" p="1">Today thirteen million</p><p t="52488" d="1215" wp="1" ws="1" p="1">people live here.</p><p t="53703" d="786" wp="1" ws="1" p="1">All walking</p><p t="54490" d="1501" wp="1" ws="1" p="2">on an ancient seabed!</p><p t="56108" d="1040" wp="1" ws="1" p="1">Where to next?</p><p t="57148" d="817" wp="1" ws="1" p="1">Drop a city</p><p t="57965" d="1188" wp="1" ws="1" p="2">we'll rewind it!</p></body></timedtext>
